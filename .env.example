# ── API ──────────────────────────────────────────────────────────────────────
PORT=8090
# Loopback by default: the API is unauthenticated and the simulator's reset
# truncates the database. Set 0.0.0.0 only on purpose.
HOST=127.0.0.1
DATABASE_URL=postgres://revenant:revenant@localhost:5434/revenant_mini
PGPOOL_MAX=10
LOG_LEVEL=info
# Comma-separated allowlist. Must match where the dashboard actually runs,
# or the browser's requests are rejected by CORS.
CORS_ORIGINS=http://localhost:3000

# ── Postgres container (read by docker-compose.yml) ──────────────────────────
# Spec §15.1 pins 5433. On this machine 5432 and 5433 are held by the
# recriauth stack, so this project uses 5434. Keep DATABASE_URL in sync.
POSTGRES_USER=revenant
POSTGRES_PASSWORD=revenant
POSTGRES_DB=revenant_mini
POSTGRES_HOST_PORT=5434

# ── Simulator ────────────────────────────────────────────────────────────────
SIM_SEED=42
# 75,000, not the spec's 5,000. §7.3's detector needs 20 attempts per 15-minute
# evaluation window, and the demo's centrepiece incident is detected on the
# international slice (18% of traffic) — which needs ~75,000 payments over 7
# days to clear that floor. At 5,000 the detector cannot fire on anything, and
# §8.7's own "2,140 failed payments" is unreachable too. See docs/phase.md §0.1.
SIM_PAYMENTS=75000
SIM_MERCHANTS=5
SIM_DAYS=7
SIM_ENDS_AT=2026-08-01T00:00:00Z
SIM_SPEED=60                 # 1 real second = 60 simulated minutes

# ── Ingest ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=revenant_mini_dev_secret

# ── LLM (optional — leave as `none` to prove the deterministic path, §14) ────
# Provider-agnostic through the Vercel AI SDK. The agent receives computed
# context and returns a closed-enum choice plus prose (§7.8), so the vendor is
# an implementation detail. Every value below is interchangeable.
#
#   none       deterministic only — narratives templated, badges read `template`
#   gateway    Vercel AI Gateway: one key, any vendor. LLM_MODEL is `vendor/model`
#   anthropic  direct, ANTHROPIC_API_KEY
#   openai     direct, OPENAI_API_KEY
#   google     direct, GOOGLE_GENERATIVE_AI_API_KEY
LLM_PROVIDER=none

# Empty uses the per-provider default in apps/api/src/lib/llm.ts:
#   gateway anthropic/claude-sonnet-5 · anthropic claude-sonnet-5
#   openai gpt-5.5 · google gemini-3.7-flash
LLM_MODEL=

# §7.8 — slower than this and the deterministic fallback takes over.
LLM_TIMEOUT_MS=4000

AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Ledger anchoring (optional — off by default, like the LLM) ───────────────
# Batches the policy log into Merkle roots and anchors only the roots, so a
# decision edited after the fact is detectable by someone who does not trust
# this database. Postgres stays the source of truth in every mode.
#
#   none       off — every other stage is identical
#   simulated  anchors to the sim_ledger table here: shows the flow and every
#              check, proves nothing to a third party
#   drunix     NPCI Drunix (Hyperledger Fabric 2.5 fork) via the Fabric Gateway
#              client and the chaincode in ledger/chaincode — see ledger/README.md
LEDGER_PROVIDER=none
LEDGER_BATCH_SIZE=256        # decisions per Merkle root (a proof is ⌈log₂ n⌉ hashes)
LEDGER_INTERVAL_MS=5000      # batch + submit pass; backs off while the ledger fails
LEDGER_TIMEOUT_MS=15000      # endorse/submit deadline; reads on /audit give up at 3 s

# Drunix test-network defaults: Org1's Lite Peer runs the Fabric Gateway.
# Paths are relative to drunix-network/test-network/organizations/peerOrganizations/org1.example.com
# — make them absolute. Cert and key may name the file or its MSP directory.
DRUNIX_PEER_ENDPOINT=localhost:7051
DRUNIX_PEER_HOST_ALIAS=peer0.org1.example.com
DRUNIX_TLS_CERT_PATH=        # …/peers/peer0.org1.example.com/tls/ca.crt
DRUNIX_MSP_ID=Org1MSP
DRUNIX_CERT_PATH=            # …/users/User1@org1.example.com/msp/signcerts
DRUNIX_KEY_PATH=             # …/users/User1@org1.example.com/msp/keystore
DRUNIX_CHANNEL=mychannel
DRUNIX_CHAINCODE=revenant-anchor

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8090
